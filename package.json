{
  "name": "npmjs",
  "version": "1.0.0",
  "description": "An npm package demo template",
  "keywords": [
    "template",
    "typescript",
    "bun",
    "esm"
  ],
  "homepage": "https://github.com/yuzhuc/npmjs#readme",
  "bugs": {
    "url": "https://github.com/yuzhuc/npmjs/issues",
    "email": "mail@arsfox.com"
  },
  "license": "MIT",
  "author": {
    "name": "yuzhuc",
    "email": "mail@arsfox.com",
    "url": "https://arsfox.com"
  },
  "contributors": [],
  "funding": {
    "type": "individual",
    "url": "https://arsfox.com/sponsor"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuzhuc/npmjs.git"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && cp esm.package.json dist/esm/package.json && cp cjs.package.json dist/cjs/package.json",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run typecheck && bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.3"
}
